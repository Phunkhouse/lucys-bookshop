# Local Postgres (read by docker compose)
POSTGRES_USER=bookshop
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bookshop
POSTGRES_PORT=5432

# App (read by Next, drizzle-kit and scripts).
# The user, password, port and database name must match the values above.
DATABASE_URL=postgres://bookshop:change-me@127.0.0.1:5432/bookshop

# Admin login (Better Auth). Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-random-string-of-32-or-more-characters
# Public address, no trailing slash. On Vercel previews leave it unset: the app uses VERCEL_URL.
# Testing from a phone: `pnpm dev` already trusts home-network origins
# (http://192.168.x.y, any port) for sign-in, so this needs no change. For any
# other address (a tunnel, a 10.x network) set it to the address you open.
BETTER_AUTH_URL=http://localhost:3000

# Photo storage. Locally this is the S3-compatible server from docker compose
# (the login below is a well-known local default, not a secret). In production it
# is Cloudflare R2: see docs/storage-setup.md. Never put real keys in this file.
STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_BUCKET=bookshop
STORAGE_ACCESS_KEY_ID=localdev
STORAGE_SECRET_ACCESS_KEY=localdev-secret
STORAGE_REGION=us-east-1
STORAGE_FORCE_PATH_STYLE=true
# The seller's bank account for QR payments, as an IBAN (CZ and 22 digits). Leave
# empty here: set the real one only in the environment settings, never in the repo.
# Empty means bank orders show no payment details yet.
SELLER_IBAN=

# Email to the seller about new orders (Resend). Leave all three empty to only log
# them. With a key, both addresses are required. Never put a real key here: set
# it only in the environment settings. NOTIFY_FROM_EMAIL is the address only, on
# the domain verified in Resend; the shop name is added in front of it.
RESEND_API_KEY=
SELLER_NOTIFY_EMAIL=
NOTIFY_FROM_EMAIL=

# The bearer token of the hourly job endpoint (/api/jobs/hourly): reminders to the
# seller and the retry of unsent mails. Empty switches the endpoint off. At least 32
# characters, for example from: openssl rand -base64 32 (a shorter value stops the
# app from starting, like BETTER_AUTH_SECRET). Never put a real one here: set it in
# the environment settings and in the scheduler that calls the endpoint.
JOBS_SECRET=

# Where photos are read from. Locally the same server; in production the public
# R2 address (https://pub-....r2.dev), later a custom domain.
IMAGE_BASE_URL=http://127.0.0.1:9000/bookshop

# Only for restoring a backup on your machine (docs/backup.md, pnpm backup:restore).
# The R2 token scoped to the backup bucket. Leave empty normally; never commit real ones.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
