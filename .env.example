# Local Postgres (read by docker compose)
POSTGRES_USER=bookshop
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bookshop
POSTGRES_PORT=5432

# App (read by Next, drizzle-kit and scripts).
# The user, password, port and database name must match the values above.
DATABASE_URL=postgres://bookshop:change-me@127.0.0.1:5432/bookshop

# Admin login (Better Auth). Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-random-string-of-32-or-more-characters
# Public address, no trailing slash. On Vercel previews leave it unset: the app uses VERCEL_URL.
# To log in from a phone on your network, set it to the address `pnpm dev` prints
# as "Network", e.g. http://192.168.68.58:3000 (it must match the address you open).
BETTER_AUTH_URL=http://localhost:3000
